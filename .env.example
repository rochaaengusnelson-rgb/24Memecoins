# Solana RPC (mainnet-beta for real launches)
RPC_URL=https://api.mainnet-beta.solana.com
# Path to the event owner's wallet keypair (JSON array). This wallet pays the $500 first buy.
OWNER_KEYPAIR=./owner.keypair.json
# Switchboard On-Demand SOL/USD pull feed (classic PullFeed account). Find one at https://explorer.switchboardlabs.xyz
SB_SOL_USD_FEED=
# Optional: refuse to launch if SOL/USD feed is older than this many seconds
SB_MAX_PRICE_AGE_SEC=120

# Dry run (npm run dryrun) RPCs; defaults are the public endpoints
# MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# DEVNET_RPC_URL=https://api.devnet.solana.com
